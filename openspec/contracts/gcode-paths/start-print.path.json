{
  "schema_version": 1,
  "path": "start_print",
  "title": "Start print",
  "entrypoints": [
    {
      "name": "OrcaSlicer start",
      "path": "orcaslicer_gcode/start.gcode",
      "must_include_order": [
        "SET_PRINT_MAIN_STATUS MAIN_STATUS=print_start",
        "M1002 R1",
        "G29.0",
        "OPTIMIZED_PRINT_START_HOME BEDTEMP=[bed_temperature_initial_layer_single] CHAMBER=[chamber_temperature]",
        "OPTIMIZED_START_PRINT_FILAMENT_PREP EXTRUDER=[initial_no_support_extruder] FIRSTLAYERTEMP=[nozzle_temperature_initial_layer] PURGETEMP={nozzle_temperature_range_high[initial_tool]} BEDTEMP=[bed_temperature_initial_layer_single] CHAMBER=[chamber_temperature]",
        "T[initial_tool]",
        "G90",
        "G1 Z10 F600",
        "G92_ Z{10 - ((nozzle_temperature_initial_layer[initial_tool] - 130) / 14 - 5.0) / 100}",
        "{if first_layer_print_min[1] - 10 >= print_bed_min[1]}",
        "G1 X{first_layer_print_min[0]+45} Y{first_layer_print_min[1]-10} F20000",
        "G1 X218 Y0 F20000",
        "M109 S[nozzle_temperature_initial_layer]",
        "G1 E6 F300",
        "G1 X{first_layer_print_min[0]+5} E20 F1200",
        "G1 X{first_layer_print_min[0]} E0.8",
        "G1 X178 E20 F1200",
        "G1 X173 E0.8",
        "SET_PRINT_MAIN_STATUS MAIN_STATUS=printing"
      ],
      "must_not_include": [
        "HOTENDTEMP=",
        "LOADTEMP=",
        "PURGETEMP=[nozzle_temperature_initial_layer]",
        "SET_INPUT_SHAPER",
        "G1 E-0.2 F1800",
        "BED_MESH_PROFILE",
        "tltg_start_bed_mesh_profile",
        "M140 S[bed_temperature_initial_layer_single]\nM141 S[chamber_temperature]\nG29.0"
      ]
    },
    {
      "name": "QIDI Studio start",
      "path": "qidistudio_gcode/start.gcode",
      "must_include_order": [
        "SET_PRINT_MAIN_STATUS MAIN_STATUS=print_start",
        "M1002 R1",
        "G29.0",
        "OPTIMIZED_PRINT_START_HOME BEDTEMP=[bed_temperature_initial_layer_single] CHAMBER=[chamber_temperatures]",
        "OPTIMIZED_START_PRINT_FILAMENT_PREP EXTRUDER=[initial_no_support_extruder] FIRSTLAYERTEMP=[nozzle_temperature_initial_layer] PURGETEMP={nozzle_temperature_range_high[initial_tool]} BEDTEMP=[bed_temperature_initial_layer_single] CHAMBER=[chamber_temperatures]",
        "T[initial_tool]",
        "G90",
        "G1 Z10 F600",
        "G92_ Z{10 - ((nozzle_temperature_initial_layer[initial_tool] - 130) / 14 - 5.0) / 100}",
        "{if first_layer_print_min[1] - 10 >= print_bed_min[1]}",
        "G1 X{first_layer_print_min[0]+45} Y{first_layer_print_min[1]-10} F20000",
        "G1 X218 Y0 F20000",
        "M109 S[nozzle_temperature_initial_layer]",
        "G1 E6 F300",
        "G1 X{first_layer_print_min[0]+5} E20 F1200",
        "G1 X{first_layer_print_min[0]} E0.8",
        "G1 X178 E20 F1200",
        "G1 X173 E0.8",
        "SET_PRINT_MAIN_STATUS MAIN_STATUS=printing"
      ],
      "must_not_include": [
        "HOTENDTEMP=",
        "LOADTEMP=",
        "PURGETEMP=[nozzle_temperature_initial_layer]",
        "SET_INPUT_SHAPER",
        "G1 E-0.2 F1800",
        "BED_MESH_PROFILE",
        "tltg_start_bed_mesh_profile",
        "M140 S[bed_temperature_initial_layer_single]\nM141 S[chamber_temperatures]\nG29.0"
      ]
    }
  ],
  "macro_files": [
    "config/box.cfg",
    "config/klipper-macros-qd/*.cfg",
    "installer/klipper/tltg-optimized-macros/*.cfg"
  ],
  "branches": [
    {
      "name": "staggered_start_settings",
      "source_macro": "OPTIMIZED_PRINT_START_HOME",
      "condition": "all optimized starts",
      "slice": {
        "start": "{% set opt = printer[\"gcode_macro _tltg_optimized_globals\"] %}",
        "end": "UPDATE_DELAYED_GCODE"
      },
      "must_include_order": [
        "{% set svv = printer.save_variables.variables %}",
        "svv.tltg_staggered_start_heating|default(opt.staggered_start_heating)|int",
        "([svv.tltg_staggered_start_heating_dwell_seconds|default(opt.staggered_start_heating_dwell_seconds)|float, 0]|max)"
      ],
      "must_not_include": [
        "SAVE_VARIABLE"
      ]
    },
    {
      "name": "staggered_explicit_dispatch",
      "source_macro": "OPTIMIZED_PRINT_START_HOME",
      "condition": "staggered_start_heating && BEDTEMP or CHAMBER is provided",
      "slice": {
        "start": "{% if explicit_targets %}",
        "end": "{% else %}"
      },
      "must_include_order": [
        "_OPTIMIZED_STAGGERED_START_EXPLICIT BEDTEMP={bed_target} CHAMBER={chamber_target} PROBETEMP={probe_target} DWELL={dwell_seconds}"
      ],
      "must_not_include": [
        "_OPTIMIZED_STAGGERED_START_ACTIVE"
      ]
    },
    {
      "name": "staggered_active_target_compatibility",
      "source_macro": "OPTIMIZED_PRINT_START_HOME",
      "condition": "staggered_start_heating && prior no-argument slicer invocation",
      "slice": {
        "start": "_OPTIMIZED_STAGGERED_START_ACTIVE PROBETEMP={probe_target} DWELL={dwell_seconds}",
        "end": "{% endif %}"
      },
      "must_include_order": [
        "_OPTIMIZED_STAGGERED_START_ACTIVE PROBETEMP={probe_target} DWELL={dwell_seconds}"
      ],
      "must_not_include": [
        "_OPTIMIZED_STAGGERED_START_EXPLICIT"
      ]
    },
    {
      "name": "concurrent_start_heating",
      "source_macro": "OPTIMIZED_PRINT_START_HOME",
      "condition": "staggered_start_heating is disabled",
      "slice": {
        "start": "{% if \"BEDTEMP\" in params %}"
      },
      "must_include_order": [
        "M140 S{bed_target}",
        "M141 S{chamber_target}",
        "M104 S{probe_target}",
        "G28"
      ],
      "must_not_include": [
        "OPTIMIZED_WAIT_BED",
        "OPTIMIZED_WAIT_CHAMBER",
        "G4 P{dwell_ms}"
      ]
    },
    {
      "name": "staggered_explicit_heating",
      "source_macro": "_OPTIMIZED_STAGGERED_START_EXPLICIT",
      "condition": "explicit targets with staggered heating enabled",
      "slice": {
        "start": "{% set bed_target = params.BEDTEMP|default(0)|float %}"
      },
      "must_include_order": [
        "M104 S0",
        "SET_HEATER_TEMPERATURE HEATER=chamber TARGET=0",
        "OPTIMIZED_WAIT_BED S={bed_target}",
        "G4 P{dwell_ms}",
        "OPTIMIZED_WAIT_CHAMBER S={chamber_target}",
        "G4 P{dwell_ms}",
        "M104 S{probe_target}"
      ],
      "must_not_include": [
        "TEMPERATURE_WAIT SENSOR=heater_bed",
        "SET_HEATER_TEMPERATURE HEATER=chamber TARGET={chamber_target}",
        "G28"
      ]
    },
    {
      "name": "staggered_active_target_heating",
      "source_macro": "_OPTIMIZED_STAGGERED_START_ACTIVE",
      "condition": "prior no-argument slicer targets with staggered heating enabled",
      "slice": {
        "start": "{% set bed_target = printer.heater_bed.target|float %}"
      },
      "must_include_order": [
        "M104 S0",
        "SET_HEATER_TEMPERATURE HEATER=chamber TARGET=0",
        "TEMPERATURE_WAIT SENSOR=heater_bed MINIMUM={([bed_target - 1, 0]|max)}",
        "G4 P{dwell_ms}",
        "SET_HEATER_TEMPERATURE HEATER=chamber TARGET={chamber_target}",
        "TEMPERATURE_WAIT SENSOR=\"heater_generic chamber\" MINIMUM={([chamber_target - 3, 0]|max)}",
        "G4 P{dwell_ms}",
        "M104 S{probe_target}"
      ],
      "must_not_include": [
        "OPTIMIZED_WAIT_BED",
        "OPTIMIZED_WAIT_CHAMBER",
        "G28"
      ]
    },
    {
      "name": "tool_mapping_reconciliation",
      "source_macro": "OPTIMIZED_START_PRINT_FILAMENT_PREP",
      "condition": "all optimized starts",
      "slice": {
        "start": "{% set tool = params.EXTRUDER|int %}",
        "end": "{% if reuse_loaded %}"
      },
      "must_include_order": [
        "_TLTG_ENSURE_TOOL_MAPPINGS",
        "SET_GCODE_VARIABLE MACRO=OPTIMIZED_END_NOZZLE_COOLDOWN_START VARIABLE=reset_tool_mappings VALUE=0",
        "SAVE_VARIABLE VARIABLE=retained_tool_ready VALUE=0"
      ],
      "must_not_include": [
        "BOX_PRINT_START",
        "_TLTG_RESET_TOOL_MAPPINGS"
      ]
    },
    {
      "name": "retained_filament_reuse",
      "source_macro": "OPTIMIZED_START_PRINT_FILAMENT_PREP",
      "condition": "reuse_loaded",
      "slice": {
        "start": "{% if reuse_loaded %}",
        "end": "{% elif box_enabled %}"
      },
      "must_include_order": [
        "SAVE_VARIABLE VARIABLE=retained_tool VALUE={tool}",
        "OPTIMIZED_MOVE_TO_TRASH",
        "OPTIMIZED_WAIT_BED S={bed_target} STATUS=wait_bed_temp",
        "OPTIMIZED_WAIT_CHAMBER S={chamber_target} STATUS=wait_chamber_temp",
        "OPTIMIZED_WAIT_HOTEND S={reuse_nozzle_target} STATUS=clear_nozzle",
        "CLEAR_OOZE",
        "CLEAR_FLUSH",
        "_OPTIMIZED_REPORT_BED_TEMP",
        "Z_TILT_ADJUST",
        "M400",
        "_OPTIMIZED_PREPARE_PRINT_MESH",
        "M1002 A1",
        "ENABLE_ALL_SENSOR"
      ],
      "must_not_include": [
        "BOX_PRINT_START",
        "OPTIMIZED_EXTRUSION_AND_FLUSH",
        "OPTIMIZED_WIPE_AND_SCRAPE_NOZZLE",
        "CLEAR_NOZZLE"
      ]
    },
    {
      "name": "box_fresh_load",
      "source_macro": "OPTIMIZED_START_PRINT_FILAMENT_PREP",
      "condition": "box_enabled && !reuse_loaded",
      "slice": {
        "start": "{% elif box_enabled %}",
        "end": "{% else %}"
      },
      "must_include_order": [
        "SET_PRINT_SUB_STATUS SUB_STATUS=change_filament",
        "BOX_PRINT_START EXTRUDER={tool} HOTENDTEMP={purge_temp}",
        "OPTIMIZED_EXTRUSION_AND_FLUSH PURGETEMP={purge_temp} CHAMBER={chamber_target}",
        "TEMPERATURE_WAIT SENSOR=extruder MAXIMUM={scrape_maximum}",
        "_OPTIMIZED_REAR_BED_SCRAPE",
        "OPTIMIZED_WAIT_BED S={bed_target} STATUS=wait_bed_temp",
        "G1 X15 Y202.5 F36000",
        "_OPTIMIZED_REPORT_BED_TEMP",
        "Z_TILT_ADJUST",
        "M400",
        "_OPTIMIZED_PREPARE_PRINT_MESH",
        "M1002 A1",
        "ENABLE_ALL_SENSOR"
      ],
      "must_not_include": [
        "CLEAR_NOZZLE",
        "OPTIMIZED_WIPE_AND_SCRAPE_NOZZLE"
      ]
    },
    {
      "name": "no_box_external_spool",
      "source_macro": "OPTIMIZED_START_PRINT_FILAMENT_PREP",
      "condition": "!box_available || !enable_box",
      "slice": {
        "start": "{% else %}"
      },
      "must_include_order": [
        "M118 Starting without QIDI Box filament prep",
        "OPTIMIZED_WIPE_AND_SCRAPE_NOZZLE TARGET={scrape_target}",
        "OPTIMIZED_WAIT_BED S={bed_target} STATUS=wait_bed_temp",
        "_OPTIMIZED_REPORT_BED_TEMP",
        "Z_TILT_ADJUST",
        "M400",
        "_OPTIMIZED_PREPARE_PRINT_MESH",
        "M1002 A1",
        "ENABLE_ALL_SENSOR"
      ],
      "must_not_include": [
        "BOX_PRINT_START",
        "OPTIMIZED_EXTRUSION_AND_FLUSH",
        "CLEAR_NOZZLE",
        "G1 E250"
      ]
    },
    {
      "name": "saved_mesh_profile",
      "source_macro": "_OPTIMIZED_PREPARE_PRINT_MESH",
      "condition": "tltg_start_bed_mesh_profile is non-empty",
      "slice": {
        "start": "{% if profile %}",
        "end": "{% else %}"
      },
      "must_include_order": [
        "action_respond_info(\"Loading saved bed mesh profile: %s\" % profile)",
        "G32",
        "SET_STEPPER_ENABLE STEPPER=extruder enable=0",
        "BED_MESH_CLEAR",
        "BED_MESH_PROFILE LOAD=\"{command_profile}\""
      ],
      "must_not_include": [
        "_OPTIMIZED_G29_HOME_Z_OR_FULL",
        "BED_MESH_CALIBRATE",
        "SAVE_CONFIG_QD"
      ]
    },
    {
      "name": "fresh_adaptive_mesh",
      "source_macro": "_OPTIMIZED_PREPARE_PRINT_MESH",
      "condition": "tltg_start_bed_mesh_profile is absent or empty",
      "slice": {
        "start": "{% else %}"
      },
      "must_include_order": [
        "action_respond_info(\"Calibrating fresh adaptive KAMP bed mesh\")",
        "G31",
        "SET_STEPPER_ENABLE STEPPER=extruder enable=0",
        "BED_MESH_CLEAR",
        "_OPTIMIZED_G29_HOME_Z_OR_FULL",
        "BED_MESH_CALIBRATE PROFILE=kamp",
        "SAVE_VARIABLE VARIABLE=profile_name VALUE='\"kamp\"'",
        "G4 P500",
        "SAVE_CONFIG_QD"
      ],
      "must_not_include": [
        "BED_MESH_PROFILE LOAD="
      ]
    },
    {
      "name": "rear_bed_scrape_motion",
      "source_macro": "_OPTIMIZED_REAR_BED_SCRAPE",
      "condition": "fresh Box or external-spool rear-bed scrape",
      "slice": {
        "start": "{% set km = printer[\"gcode_macro _km_globals\"] %}"
      },
      "must_include_order": [
        "OPTIMIZED_MOVE_TO_TRASH",
        "M204 S10000",
        "G1 Y{km.park_y - 50} F{opt.rear_scrape_orient_speed_xy}",
        "G1 X380 F{opt.rear_scrape_orient_speed_xy}",
        "G1 X188 F{opt.rear_scrape_orient_speed_xy}",
        "G1 Y392 F{opt.trash_final_approach_speed_xy}",
        "G1 Z-0.2 F480",
        "G1 X15 F200",
        "G1 Y3",
        "G1 X-15",
        "G1 Y-3",
        "G1 X15",
        "G1 Z10",
        "G1 Y383 F12000",
        "SET_VELOCITY_LIMIT ACCEL={saved_accel}"
      ],
      "must_not_include": [
        "G1 Y395 F6000",
        "G1 Y2",
        "G1 Y-2"
      ]
    }
  ],
  "generated": {
    "markdown": "openspec/contracts/gcode-paths/generated/start-print.md",
    "mermaid": "openspec/contracts/gcode-paths/generated/start-print.mmd"
  }
}
